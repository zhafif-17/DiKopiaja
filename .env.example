# ---------- APLIKASI ----------
NODE_ENV=development
APP_NAME=DiKopiaja
PORT=4000
CLIENT_URL=http://localhost:5173
API_BASE_URL=http://localhost:4000
TZ=Asia/Jakarta

# ---------- DATABASE (PostgreSQL + Drizzle) ----------
DATABASE_URL=postgresql://dikopiaja:dikopiaja_dev@localhost:5432/dikopiaja
DATABASE_SSL=false

# ---------- AUTENTIKASI (JWT + Cookie) ----------
JWT_SECRET=ganti-dengan-string-acak-minimal-64-karakter
JWT_EXPIRES_IN=12h
COOKIE_DOMAIN=localhost
COOKIE_SECURE=false
BCRYPT_SALT_ROUNDS=12
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCK_MINUTES=15

# ---------- MIDTRANS ----------
MIDTRANS_MERCHANT_ID=G000000000
MIDTRANS_CLIENT_KEY=SB-Mid-client-xxxxxxxxxxxxxxxx
MIDTRANS_SERVER_KEY=SB-Mid-server-xxxxxxxxxxxxxxxx
MIDTRANS_IS_PRODUCTION=false
MIDTRANS_SNAP_EXPIRY_MINUTES=15
MIDTRANS_NOTIFICATION_PATH=/api/webhooks/midtrans

# ---------- FRONTEND (VITE) ----------
VITE_API_BASE_URL=http://localhost:4000/api
VITE_MIDTRANS_CLIENT_KEY=SB-Mid-client-xxxxxxxxxxxxxxxx
VITE_MIDTRANS_IS_PRODUCTION=false
VITE_APP_NAME=DiKopiaja

# ---------- PENJADWALAN & NOTIFIKASI ----------
DAILY_REPORT_CRON=0 21 * * *
NOTIFICATION_RETENTION_DAYS=90
LOW_STOCK_RENOTIFY_HOURS=12

# ---------- RATE LIMIT & KEAMANAN ----------
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_GENERAL=100
RATE_LIMIT_MAX_LOGIN=10

